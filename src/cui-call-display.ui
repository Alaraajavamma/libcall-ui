<?xml version="1.0" encoding="UTF-8"?>
<interface domain="call-ui">
  <requires lib="gtk+" version="3.20"/>
  <requires lib="libhandy" version="1.0"/>
  <template class="CuiCallDisplay" parent="GtkOverlay">
    <property name="visible">True</property>
    <property name="sensitive">False</property>
    <property name="vexpand">True</property>
    <child>
      <object class="GtkBox">
        <property name="width-request">300</property>
        <property name="visible">True</property>
        <property name="sensitive" bind-source="dial_pad_revealer" bind-property="reveal-child" bind-flags="bidirectional|sync-create|invert-boolean">False</property>
        <property name="halign">center</property>
        <property name="vexpand">True</property>
        <property name="valign">center</property>
        <property name="orientation">vertical</property>
        <property name="spacing">24</property>
        <child>
          <object class="GtkScrolledWindow" id="bg_scrolled">
            <property name="visible">False</property>
            <property name="no-show-all">True</property>
            <property name="hscrollbar-policy">never</property>
            <property name="propagate-natural-height">True</property>
            <property name="max-content-height">180</property>
            <child>
              <object class="GtkBox" id="bg_calls">
                <property name="visible">True</property>
                <property name="orientation">vertical</property>
                <property name="spacing">8</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="call_info">
            <property name="visible">True</property>
            <property name="hexpand">True</property>
            <property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <child>
              <object class="GtkBox" id="contact_info">
                <property name="visible">True</property>
                <property name="orientation">vertical</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkLabel" id="primary_contact_info">
                    <property name="visible">True</property>
                    <property name="ellipsize">middle</property>
                    <property name="label" translatable="no">Name Placeholder</property>
                    <style>
                      <class name="title-2"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="secondary_contact_info">
                    <property name="visible">True</property>
                    <property name="ellipsize">middle</property>
                    <property name="label" translatable="no">Number Placeholder</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="HdyAvatar" id="avatar">
                <property name="visible">False</property>
                <property name="no-show-all">True</property>
                <property name="size">80</property>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="call_status">
                <property name="visible">True</property>
                <property name="orientation">vertical</property>
                <property name="spacing">8</property>
                <child>
                  <object class="GtkLabel" id="status">
                    <property name="name">cui_call_display_status</property>
                    <property name="visible">True</property>
                    <property name="ellipsize">middle</property>
                    <style>
                      <class name="title-3"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="answer_hint">
                    <property name="visible">False</property>
                    <property name="no-show-all">True</property>
                    <property name="wrap">True</property>
                    <property name="justify">center</property>
                    <property name="label" translatable="yes">Answering holds the current call</property>
                    <style>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="CuiEncryptionIndicator" id="encryption_indicator">
                    <property name="visible">True</property>
                    <style>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="controls">
            <property name="name">cui_call_buttons</property>
            <property name="visible">True</property>
            <property name="orientation">vertical</property>
            <property name="spacing">10</property>
            <property name="valign">end</property>
            <child>
              <object class="GtkBox" id="general_controls">
                <property name="visible">True</property>
                <property name="spacing">10</property>
                <property name="homogeneous">True</property>
            <child>
              <object class="GtkToggleButton" id="speaker">
                <property name="visible">True</property>
                <property name="receives-default">False</property>
                <property name="height-request">56</property>
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="spacing">10</property>
                    <property name="halign">center</property>
                    <child>
                      <object class="GtkImage">
                        <property name="visible">True</property>
                        <property name="pixel-size">20</property>
                        <property name="icon-name">audio-speakers-symbolic</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="speaker_label">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Earpiece</property>
                        <style>
                          <class name="cui-row-state"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <style>
                  <class name="cui-row-button"/>
                </style>
              </object>
            </child>
<child>
              <object class="GtkToggleButton" id="mute">
                <property name="visible">True</property>
                <property name="receives-default">False</property>
                <property name="height-request">56</property>
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="spacing">10</property>
                    <property name="halign">center</property>
                    <child>
                      <object class="GtkImage">
                        <property name="visible">True</property>
                        <property name="pixel-size">20</property>
                        <property name="icon-name">microphone-sensitivity-muted-symbolic</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="mute_label">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Microphone</property>
                        <style>
                          <class name="cui-row-state"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <style>
                  <class name="cui-row-button"/>
                </style>
              </object>
            </child>
                          </object>
            </child>
            <child>
              <object class="GtkBox" id="gsm_controls">
                <property name="visible">True</property>
                <property name="orientation">vertical</property>
                <property name="spacing">10</property>
            <child>
              <object class="GtkToggleButton" id="dial_pad">
                <property name="visible">True</property>
                <property name="receives-default">False</property>
                <property name="height-request">56</property>
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="spacing">10</property>
                    <property name="halign">center</property>
                    <child>
                      <object class="GtkImage">
                        <property name="visible">True</property>
                        <property name="pixel-size">20</property>
                        <property name="icon-name">input-dialpad-symbolic</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Keypad</property>
                      </object>
                    </child>
                  </object>
                </child>
                <style>
                  <class name="cui-row-button"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkToggleButton" id="actions">
                <property name="visible">True</property>
                <property name="receives-default">False</property>
                <property name="height-request">56</property>
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="spacing">10</property>
                    <property name="halign">center</property>
                    <child>
                      <object class="GtkImage">
                        <property name="visible">True</property>
                        <property name="pixel-size">20</property>
                        <property name="icon-name">view-more-symbolic</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="actions_label">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Actions</property>
                      </object>
                    </child>
                  </object>
                </child>
                <style>
                  <class name="cui-row-button"/>
                </style>
              </object>
            </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="action_box">
            <property name="visible">True</property>
            <property name="hexpand">True</property>
            <property name="orientation">vertical</property>
            <property name="spacing">10</property>
            <child>
              <object class="GtkButton" id="answer">
                <property name="name">answer</property>
                <property name="height-request">56</property>
                <property name="visible">True</property>
                <property name="hexpand">True</property>
                <property name="receives-default">False</property>
                <signal name="clicked" handler="on_answer_clicked" swapped="yes"/>
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="label" translatable="yes">Answer</property>
                  </object>
                </child>
                <style>
                  <class name="cui-row-button"/>
                  <class name="cui-answer"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="hang_up">
                <property name="name">hang_up</property>
                <property name="height-request">56</property>
                <property name="visible">True</property>
                <property name="hexpand">True</property>
                <property name="receives-default">False</property>
                <signal name="clicked" handler="on_hang_up_clicked" swapped="yes"/>
                <child>
                  <object class="GtkLabel" id="hang_up_label">
                    <property name="visible">True</property>
                    <property name="label" translatable="yes">Hang Up</property>
                  </object>
                </child>
                <style>
                  <class name="cui-row-button"/>
                  <class name="cui-hang-up"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
      <packing>
        <property name="index">-1</property>
      </packing>
    </child>
    <child type="overlay">
      <object class="GtkRevealer" id="speaker_revealer">
        <property name="visible">True</property>
        <property name="valign">end</property>
        <property name="hexpand">True</property>
        <property name="vexpand">False</property>
        <property name="transition-type">slide-up</property>
        <property name="reveal-child" bind-source="speaker" bind-property="active" bind-flags="bidirectional|sync-create">False</property>
        <child>
          <object class="GtkActionBar">
            <property name="visible">True</property>
            <child type="center">
              <object class="GtkBox" id="box_speaker">
                <property name="width-request">300</property>
                <property name="visible">True</property>
                <property name="margin-top">8</property>
                <property name="margin-bottom">24</property>
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <child>
                  <object class="GtkButton">
                    <property name="width-request">160</property>
                    <property name="height-request">34</property>
                    <property name="visible">True</property>
                    <property name="receives-default">False</property>
                    <property name="halign">center</property>
                    <property name="valign">start</property>
                    <property name="relief">none</property>
                    <property name="always-show-image">True</property>
                    <signal name="clicked" handler="hide_output_clicked_cb" swapped="yes"/>
                    <child>
                      <object class="GtkImage">
                        <property name="visible">True</property>
                        <property name="pixel-size">24</property>
                        <property name="icon-name">go-down-symbolic</property>
                      </object>
                    </child>
                    <style>
                      <class name="circular"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <style>
              <class name="background"/>
            </style>
          </object>
        </child>
      </object>
    </child>
    <child type="overlay">
      <object class="GtkRevealer" id="mute_revealer">
        <property name="visible">True</property>
        <property name="valign">end</property>
        <property name="hexpand">True</property>
        <property name="vexpand">False</property>
        <property name="transition-type">slide-up</property>
        <property name="reveal-child" bind-source="mute" bind-property="active" bind-flags="bidirectional|sync-create">False</property>
        <child>
          <object class="GtkActionBar">
            <property name="visible">True</property>
            <child type="center">
              <object class="GtkBox" id="box_mute">
                <property name="width-request">300</property>
                <property name="visible">True</property>
                <property name="margin-top">8</property>
                <property name="margin-bottom">24</property>
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <child>
                  <object class="GtkButton">
                    <property name="width-request">160</property>
                    <property name="height-request">34</property>
                    <property name="visible">True</property>
                    <property name="receives-default">False</property>
                    <property name="halign">center</property>
                    <property name="valign">start</property>
                    <property name="relief">none</property>
                    <property name="always-show-image">True</property>
                    <signal name="clicked" handler="hide_input_clicked_cb" swapped="yes"/>
                    <child>
                      <object class="GtkImage">
                        <property name="visible">True</property>
                        <property name="pixel-size">24</property>
                        <property name="icon-name">go-down-symbolic</property>
                      </object>
                    </child>
                    <style>
                      <class name="circular"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <style>
              <class name="background"/>
            </style>
          </object>
        </child>
      </object>
    </child>
    <child type="overlay">
      <object class="GtkRevealer" id="actions_revealer">
        <property name="visible">True</property>
        <property name="valign">end</property>
        <property name="hexpand">True</property>
        <property name="vexpand">False</property>
        <property name="transition-type">slide-up</property>
        <property name="reveal-child" bind-source="actions" bind-property="active" bind-flags="bidirectional|sync-create">False</property>
        <child>
          <object class="GtkActionBar">
            <property name="visible">True</property>
            <child type="center">
              <object class="GtkBox" id="box_actions">
                <property name="width-request">300</property>
                <property name="visible">True</property>
                <property name="margin-top">8</property>
                <property name="margin-bottom">24</property>
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <child>
                  <object class="GtkButton">
                    <property name="width-request">160</property>
                    <property name="height-request">34</property>
                    <property name="visible">True</property>
                    <property name="receives-default">False</property>
                    <property name="halign">center</property>
                    <property name="valign">start</property>
                    <property name="relief">none</property>
                    <property name="always-show-image">True</property>
                    <signal name="clicked" handler="hide_actions_clicked_cb" swapped="yes"/>
                    <child>
                      <object class="GtkImage">
                        <property name="visible">True</property>
                        <property name="pixel-size">24</property>
                        <property name="icon-name">go-down-symbolic</property>
                      </object>
                    </child>
                    <style>
                      <class name="circular"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="hold">
                    <property name="visible">True</property>
                    <property name="receives-default">False</property>
                    <property name="height-request">56</property>
                    <signal name="toggled" handler="hold_toggled_cb" swapped="no"/>
                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="spacing">10</property>
                        <property name="halign">center</property>
                        <child>
                          <object class="GtkImage">
                            <property name="visible">True</property>
                            <property name="pixel-size">20</property>
                            <property name="icon-name">media-playback-pause-symbolic</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="hold_label">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">Hold</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <style>
                      <class name="cui-row-button"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="add_call">
                    <property name="visible">True</property>
                    <property name="receives-default">False</property>
                    <property name="height-request">56</property>
                    <signal name="clicked" handler="add_call_clicked_cb" swapped="no"/>
                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="spacing">10</property>
                        <property name="halign">center</property>
                        <child>
                          <object class="GtkImage">
                            <property name="visible">True</property>
                            <property name="pixel-size">20</property>
                            <property name="icon-name">list-add-symbolic</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">Add call</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <style>
                      <class name="cui-row-button"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <style>
              <class name="background"/>
            </style>
          </object>
        </child>
      </object>
    </child>
    <child type="overlay">
      <object class="GtkRevealer" id="dial_pad_revealer">
        <property name="visible">True</property>
        <property name="valign">end</property>
        <property name="hexpand">True</property>
        <property name="vexpand">False</property>
        <property name="transition-type">slide-up</property>
        <property name="reveal-child" bind-source="dial_pad" bind-property="active" bind-flags="bidirectional|sync-create">False</property>
        <child>
          <object class="GtkActionBar">
            <property name="visible">True</property>
            <child type="center">
              <object class="GtkBox" id="box_keypad">
                <property name="width-request">300</property>
                <property name="visible">True</property>
                <property name="margin-top">8</property>
                <property name="margin-bottom">24</property>
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <child>
                  <object class="GtkButton">
                    <property name="width-request">160</property>
                    <property name="height-request">34</property>
                    <property name="visible">True</property>
                    <property name="receives-default">False</property>
                    <property name="halign">center</property>
                    <property name="valign">start</property>
                    <property name="relief">none</property>
                    <property name="always-show-image">True</property>
                    <signal name="clicked" handler="hide_dial_pad_clicked_cb" swapped="yes"/>
                    <child>
                      <object class="GtkImage">
                        <property name="visible">True</property>
                        <property name="pixel-size">24</property>
                        <property name="icon-name">go-down-symbolic</property>
                      </object>
                    </child>
                    <style>
                      <class name="circular"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="keypad_entry">
                    <property name="visible">True</property>
                    <property name="hexpand">True</property>
                    <property name="xalign">0.5</property>
                    <signal name="delete-text" handler="block_delete_cb" swapped="no"/>
                    <signal name="insert-text" handler="insert_text_cb" swapped="no"/>
                    <style>
                      <class name="phone-number-entry"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="CuiKeypad" id="keypad">
                    <property name="visible">True</property>
                    <property name="letters-visible">False</property>
                    <property name="column_spacing">16</property>
                    <property name="row_spacing">10</property>
                    <property name="halign">center</property>
                    <property name="entry">keypad_entry</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="keypad_speaker">
                    <property name="visible">True</property>
                    <property name="no-show-all">True</property>
                    <property name="receives-default">False</property>
                    <property name="height-request">56</property>
                    <signal name="clicked" handler="keypad_speaker_clicked_cb" swapped="yes"/>
                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="spacing">10</property>
                        <property name="halign">center</property>
                        <child>
                          <object class="GtkImage">
                            <property name="visible">True</property>
                            <property name="pixel-size">20</property>
                            <property name="icon-name">audio-volume-high-symbolic</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">Turn to Speaker</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <style>
                      <class name="cui-row-button"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <style>
              <class name="background"/>
            </style>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
